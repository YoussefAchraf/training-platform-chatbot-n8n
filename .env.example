# Copy this file to .env and fill in real values. .env is gitignored on
# purpose - it holds real credentials and should never be committed.
#
# cp .env.example .env

# ---- n8n instance ----
# A random secret n8n uses to encrypt stored credentials in its database.
# Generate your own - do not reuse this or any shared value:
#   openssl rand -hex 16
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Africa/Casablanca

# Base URL n8n uses when it prints/generates webhook URLs (test and
# production alike). Change the host/port if you're not running this on
# localhost:5678.
N8N_WEBHOOK_URL=http://localhost:5678/

# Required: n8n blocks $env access from expressions inside sub-nodes (e.g.
# HTTP Tool node URLs called by an AI Agent) unless this is explicitly set
# to false. The tool nodes in this workflow read $env.BACKEND_API_URL, so
# this must stay false.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ---- Owner account, created automatically on first boot ----
# A real admin login for the n8n editor at http://localhost:5678. Change
# the password before exposing this instance beyond your own machine.
N8N_OWNER_EMAIL=admin@localhost.local
N8N_OWNER_PASSWORD=ChangeMe123456!

# ---- Backend the workflow's HTTP tool nodes call ----
# The training-platform-backend API this chatbot talks to. If the backend
# runs in its own separate docker-compose project on the same machine,
# host.docker.internal lets this container reach its host-published port.
# Change the port if your backend's PORT differs from the default 4000.
BACKEND_API_URL=http://host.docker.internal:4000

# ---- Optional: MCP server for the SuperAdmin "extended tools" branch ----
# Leave empty unless you're running one. The MCP tool is intentionally
# disconnected from the SuperAdmin agent in the workflow until this is
# set up - see the workflow's MCP Client Tool node for how to reconnect it.
MCP_SERVER_URL=

# ---- AI model provider ----
# Any provider that speaks the OpenAI chat-completions format works here -
# see the README's "The AI model" section for details and for how to
# switch to a native (non-OpenAI-compatible) provider instead.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Redis (rate-limit + FAQ cache nodes) ----
# Only change HOST/PORT if you're pointing at a Redis instance other than
# the one this docker-compose file already starts for you. PASSWORD is
# required - docker-compose.yml passes it to redis-server's --requirepass
# and bootstrap.js bakes it into the auto-created Redis credential; there's
# no default, generate your own (e.g. `openssl rand -hex 16`).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Observability: n8n's own built-in Prometheus metrics ----
# Generic execution/webhook/duration/success-failure metrics, served at
# GET http://localhost:5678/metrics.
N8N_METRICS=true
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
N8N_METRICS_INCLUDE_WORKFLOW_NAME_LABEL=true
N8N_METRICS_INCLUDE_WORKFLOW_STATISTICS=true
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
N8N_METRICS_INCLUDE_API_PATH_LABEL=true
N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL=true
N8N_METRICS_INCLUDE_CACHE_METRICS=true

# ---- Observability: the custom metrics-exporter service ----
# Token usage, estimated cost, and per-tool call reliability - the part
# n8n's own metrics don't cover. Served at http://localhost:9464/metrics.
# Reuses N8N_OWNER_EMAIL/N8N_OWNER_PASSWORD above to read execution
# history via n8n's REST API - no separate credential needed.
EXPORTER_POLL_INTERVAL_SECONDS=15
EXPORTER_PORT=9464
# USD per 1M tokens - set to match your real AI provider's pricing. No
# real cost figure is stored in n8n's execution data, only token counts,
# so this is an estimate for watching spend trend, not a billed number.
AI_PRICE_PROMPT_PER_1M_USD=0.10
AI_PRICE_COMPLETION_PER_1M_USD=0.40
