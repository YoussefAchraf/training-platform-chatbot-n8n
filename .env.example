
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Africa/Casablanca

N8N_WEBHOOK_URL=http://localhost:5678/

N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# The trunk workflow's JWT-signature check needs Node's built-in crypto
# module inside a Code node - n8n's JS Task Runner blocks all require()
# calls by default, this explicitly allow-lists just this one.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

N8N_OWNER_EMAIL=admin@localhost.local
N8N_OWNER_PASSWORD=ChangeMe123456!

BACKEND_API_URL=http://host.docker.internal:4000

# Must be the exact same value as training-platform-backend's own JWT_SECRET
# (see that repo's .env / TokenService.ts) - this is what lets the trunk
# workflow verify a caller's JWT signature itself before trusting the role
# claim inside it, instead of just decoding it unverified. Never commit a
# real value here.
JWT_SECRET=

MCP_SERVER_URL=

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

N8N_METRICS=true
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
N8N_METRICS_INCLUDE_WORKFLOW_NAME_LABEL=true
N8N_METRICS_INCLUDE_WORKFLOW_STATISTICS=true
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
N8N_METRICS_INCLUDE_API_PATH_LABEL=true
N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL=true
N8N_METRICS_INCLUDE_CACHE_METRICS=true

EXPORTER_POLL_INTERVAL_SECONDS=15
EXPORTER_PORT=9464
AI_PRICE_PROMPT_PER_1M_USD=0.10
AI_PRICE_COMPLETION_PER_1M_USD=0.40
